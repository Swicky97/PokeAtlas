## Ignore Visual Studio temporary files, build results,
## and files generated by popular Visual Studio add-ons.

###############
# User-specific
###############
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

#################
# Build Results
#################
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

#################
# Visual Studio
#################
.vs/

#################
# Rider
#################
.idea/

#################
# VS Code
#################
.vscode/

#################
# NuGet
#################
*.nupkg
*.snupkg
packages/
!packages/build/
*.nuget.props
*.nuget.targets

#################
# Test Results
#################
[Tt]est[Rr]esult*/
[Bb]enchmark[Dd]ot[Nn]et.Artifacts/

#################
# Publish
#################
publish/
artifacts/

#################
# Logs
#################
*.log

#################
# Windows
#################
Thumbs.db
Desktop.ini

#################
# Generated Files
#################
Generated/
GeneratedFiles/

#################
# Coverage
#################
coverage/
coverage.xml
*.coverage
*.coveragexml

#################
# Dotnet Tools
#################
.dotnet/

#################
# Environment
#################
.env
.env.*
!.env.example

#################
# Temporary Files
#################
*.tmp
*.temp

#################
# ReSharper
#################
_ReSharper*/
*.DotSettings.user

#################
# JetBrains Rider
#################
*.sln.iml

#################
# Node (if you later add a frontend)
#################
node_modules/
dist/

#################
# Atlas Output
#################
Output/
Exports/